---
import { Icon } from "astro-icon/components";

interface ContactIconEntry {
    id?: string;
    url: string;
    icon: string;
    alt: string;
    title: string;
}

const entries: ContactIconEntry[] = [
    {
        id: "email-icon-link",
        url: "#",
        icon: "fa7-solid:envelope",
        alt: "Email",
        title: "Send Kian an email",
    },
    {
        url: "https://linkedin.com/in/kiankasad",
        icon: "devicon:linkedin",
        alt: "LinkedIn",
        title: "LinkedIn profile",
    },
    {
        url: "https://github.com/kdkasad",
        icon: "devicon:github",
        alt: "GitHub",
        title: "GitHub profile",
    },
    {
        url: "/resume.pdf",
        icon: "fa7-solid:file-text",
        alt: "File icon",
        title: "Résumé (PDF)",
    },
];
---

<div class="flex flex-row items-center gap-3">
    {
        entries.map((entry) => (
            <a
                id={entry.id}
                href={entry.url}
                title={entry.title}
                target="_blank"
                class="size-8 transition-opacity duration-200 hover:opacity-80"
            >
                <Icon name={entry.icon} desc={entry.alt} class="size-8" />
            </a>
        ))
    }
</div>

<script>
    const setEmail = () => {
        const el = document.getElementById(
            "email-icon-link",
        ) as HTMLAnchorElement | null;
        if (el) el.href = "mailto:" + "kian" + "@" + window.location.hostname;
    };
    document.addEventListener("mousemove", setEmail, { once: true });
    document.addEventListener("touchstart", setEmail, { once: true });
</script>
